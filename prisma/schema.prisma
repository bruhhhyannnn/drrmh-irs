generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auth_id             String                      @unique @db.Uuid
  unit_id             String?                     @db.Uuid
  position_id         String?                     @db.Uuid
  user_type_id        String                      @db.Uuid
  username            String                      @unique
  email               String                      @unique
  first_name          String                      @default("")
  middle_name         String?
  last_name           String                      @default("")
  suffix              String?
  is_active           Boolean                     @default(true)
  created_at          DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at          DateTime                    @default(now()) @updatedAt @db.Timestamptz(6)
  is_profile_complete Boolean                     @default(false)
  cluster_id          String?                     @db.Uuid
  campus_id           String?                     @db.Uuid
  events              Event[]                     @relation("CreatedBy")
  completed_events    Event[]                     @relation("CompletedBy")
  reports             Report[]
  campus              campus?                     @relation(fields: [campus_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cluster             Cluster?                    @relation(fields: [cluster_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  position            Position?                   @relation(fields: [position_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit                Unit?                       @relation(fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_type           UserType                    @relation(fields: [user_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessments         Assessment[]                @relation("AssessmentEvaluator")
  created_buildings   Building[]                  @relation("BuildingCreatedBy")
  published_versions  AssessmentTemplateVersion[] @relation("VersionPublishedBy")
  created_versions    AssessmentTemplateVersion[] @relation("VersionCreatedBy")

  @@index([cluster_id], map: "idx_users_cluster_id")
  @@map("users")
}

model Cluster {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String              @unique
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  campus_id         String              @db.Uuid
  bystander_reports bystander_reports[]
  campus            campus              @relation(fields: [campus_id], references: [id], onDelete: Cascade)
  reports           Report[]
  units             Unit[]
  users             User[]

  @@map("clusters")
}

model Unit {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  cluster_id        String              @db.Uuid
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  bystander_reports bystander_reports[]
  reports           Report[]
  cluster           Cluster             @relation(fields: [cluster_id], references: [id], onDelete: Cascade)
  users             User[]
  buildings         Building[]

  @@unique([name, cluster_id])
  @@map("units")
}

model Event {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String?      @db.Uuid
  status_id    String       @db.Uuid
  name         String
  description  String?
  quarter      String?
  started_at   DateTime?    @db.Timestamptz(6)
  ended_at     DateTime?    @db.Timestamptz(6)
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  updated_at   DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  campus_id    String       @db.Uuid
  /// Who pressed Complete event (or set the status to Completed). Null for older events and
  /// whenever the status is not Completed. See prisma/manual/DRRM-011-super-admin-v2.sql.
  completed_by String?      @db.Uuid
  campus       campus       @relation(fields: [campus_id], references: [id], onDelete: NoAction)
  status       EventStatus  @relation(fields: [status_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user         User?        @relation("CreatedBy", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  completer    User?        @relation("CompletedBy", fields: [completed_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reports      Report[]
  assessments  Assessment[]

  @@index([user_id])
  @@map("events")
}

model Report {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id             String                  @db.Uuid
  user_id              String?                 @db.Uuid
  cluster_id           String                  @db.Uuid
  unit_id              String?                 @db.Uuid
  faculty_members      Int                     @default(0)
  admin_members        Int                     @default(0)
  reps_members         Int                     @default(0)
  ra_members           Int                     @default(0)
  students             Int                     @default(0)
  philcare_staff       Int                     @default(0)
  security_personnel   Int                     @default(0)
  construction_workers Int                     @default(0)
  tenants              Int                     @default(0)
  health_workers       Int                     @default(0)
  non_academic_staff   Int                     @default(0)
  guests               Int                     @default(0)
  submitted_at         DateTime                @default(now()) @db.Timestamptz(6)
  created_at           DateTime                @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  damage_condition_id  String?                 @db.Uuid
  latitude             Decimal?                @db.Decimal(10, 8)
  location_name        String?
  longitude            Decimal?                @db.Decimal(11, 8)
  casualties           ReportCasualty[]
  missing_persons      ReportMissingPerson[]
  population_counts    ReportPopulationCount[]
  cluster              Cluster                 @relation(fields: [cluster_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  damage_conditions    DamageCondition?        @relation(fields: [damage_condition_id], references: [id], onUpdate: NoAction)
  event                Event                   @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  unit                 Unit?                   @relation(fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                 User?                   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([event_id])
  @@index([user_id])
  @@index([cluster_id])
  @@map("reports")
}

model CasualtyCondition {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String           @unique
  is_active  Boolean          @default(true)
  created_at DateTime         @default(now()) @db.Timestamptz(6)
  updated_at DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  casualties ReportCasualty[]

  @@map("casualty_conditions")
}

model ReportCasualty {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_id           String?            @db.Uuid
  condition_id        String             @db.Uuid
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  age                 Int?
  bystander_report_id String?            @db.Uuid
  name                String             @default("")
  sex                 String?
  diagnosis           String?
  bystander_reports   bystander_reports? @relation(fields: [bystander_report_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  condition           CasualtyCondition  @relation(fields: [condition_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  report              Report?            @relation(fields: [report_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([report_id])
  @@index([bystander_report_id], map: "idx_report_casualties_bystander")
  @@map("report_casualties")
}

model ReportMissingPerson {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_id           String?            @db.Uuid
  name                String
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  age                 Int?
  bystander_report_id String?            @db.Uuid
  sex                 String?
  bystander_reports   bystander_reports? @relation(fields: [bystander_report_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  report              Report?            @relation(fields: [report_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([report_id])
  @@index([bystander_report_id], map: "idx_report_missing_persons_bystander")
  @@map("report_missing_persons")
}

model DamageCondition {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String              @unique
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  bystander_reports bystander_reports[]
  reports           Report[]

  @@map("damage_conditions")
}

model Position {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  users      User[]

  @@map("positions")
}

model UserType {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  users      User[]

  @@map("user_types")
}

model EventStatus {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  events     Event[]

  @@map("event_statuses")
}

model bystander_incident_types {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String              @unique
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  bystander_reports bystander_reports[]
}

model bystander_report_statuses {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String              @unique
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  bystander_reports bystander_reports[]
}

model bystander_reports {
  id                        String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cluster_id                String                           @db.Uuid
  unit_id                   String?                          @db.Uuid
  latitude                  Decimal                          @db.Decimal(10, 8)
  longitude                 Decimal                          @db.Decimal(11, 8)
  submitted_at              DateTime                         @default(now()) @db.Timestamptz(6)
  created_at                DateTime                         @default(now()) @db.Timestamptz(6)
  incident_type_id          String?                          @db.Uuid
  status_id                 String?                          @db.Uuid
  description               String?
  location_description      String?
  damage_condition_id       String?                          @db.Uuid
  /// Optional follow-up number from the reporter, stored as +63XXXXXXXXX. Admin-only.
  contact_number            String?
  /// Object paths in the private `bystander-photos` Storage bucket (max 3).
  photo_paths               String[]                         @default([])
  clusters                  Cluster                          @relation(fields: [cluster_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  damage_conditions         DamageCondition?                 @relation(fields: [damage_condition_id], references: [id], onUpdate: NoAction)
  bystander_incident_types  bystander_incident_types?        @relation(fields: [incident_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bystander_report_statuses bystander_report_statuses?       @relation(fields: [status_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  units                     Unit?                            @relation(fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  report_casualties         ReportCasualty[]
  report_missing_persons    ReportMissingPerson[]
  population_counts         BystanderReportPopulationCount[]

  @@index([incident_type_id])
  @@index([status_id])
}

/// Headcount on a bystander report — same shape as ReportPopulationCount. Has a count >= 0
/// check constraint (prisma/manual/DRRM-008-bystander-report-v2.sql).
model BystanderReportPopulationCount {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bystander_report_id String             @db.Uuid
  category_id         String             @db.Uuid
  count               Int                @default(0)
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  bystander_report    bystander_reports  @relation(fields: [bystander_report_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category            PopulationCategory @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([bystander_report_id, category_id], map: "uq_bystander_pop_counts_report_category")
  @@map("bystander_report_population_counts")
}

model campus {
  id                    String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  is_active             Boolean                    @default(true)
  population_categories CampusPopulationCategory[]
  clusters              Cluster[]
  events                Event[]
  users                 User[]
}

model PopulationCategory {
  id                      String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                    String                           @unique
  name                    String
  description             String?
  is_active               Boolean                          @default(true)
  created_at              DateTime                         @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                         @default(now()) @updatedAt @db.Timestamptz(6)
  campus_links            CampusPopulationCategory[]
  report_counts           ReportPopulationCount[]
  bystander_report_counts BystanderReportPopulationCount[]

  @@map("population_categories")
}

model CampusPopulationCategory {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campus_id   String             @db.Uuid
  category_id String             @db.Uuid
  sort_order  Int                @default(0)
  is_required Boolean            @default(false)
  is_active   Boolean            @default(true)
  created_at  DateTime           @default(now()) @db.Timestamptz(6)
  updated_at  DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  campus      campus             @relation(fields: [campus_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category    PopulationCategory @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([campus_id, category_id])
  @@index([campus_id, sort_order], map: "idx_campus_pop_cat_campus")
  @@map("campus_population_categories")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ReportPopulationCount {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_id   String             @db.Uuid
  category_id String             @db.Uuid
  count       Int                @default(0)
  created_at  DateTime           @default(now()) @db.Timestamptz(6)
  updated_at  DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  category    PopulationCategory @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  report      Report             @relation(fields: [report_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([report_id, category_id])
  @@index([report_id], map: "idx_report_pop_counts_report")
  @@map("report_population_counts")
}

// ─── MATATAG building assessment (prisma/manual/DRRM-015-assessment.sql) ─────────────────

enum AssessmentAnswer {
  yes
  no
  na

  @@map("assessment_answer")
}

enum AssessmentSafeAnswer {
  yes
  no

  @@map("assessment_safe_answer")
}

enum AssessmentVersionStatus {
  draft
  published
  retired

  @@map("assessment_version_status")
}

/// The four DRRM pillars (RA 10121). `code` is the slug of PILLARS in src/lib/pillars.ts.
model DrrmPillar {
  id         String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String                  @unique
  name       String
  sort_order Int                     @default(0)
  created_at DateTime                @default(now()) @db.Timestamptz(6)
  updated_at DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  items      AssessmentItem[]
  scores     AssessmentPillarScore[]

  @@map("drrm_pillars")
}

/// Kinds of area a building can have (corridors, laboratories, swimming pool …). Shared across
/// template versions, so a building's profile survives a new version.
model BuildingAreaType {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String              @unique
  name_en          String
  name_fil         String
  sort_order       Int                 @default(0)
  is_active        Boolean             @default(true)
  created_at       DateTime            @default(now()) @db.Timestamptz(6)
  updated_at       DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  sections         AssessmentSection[]
  items            AssessmentItem[]
  building_areas   BuildingArea[]
  assessment_areas AssessmentArea[]

  @@map("building_area_types")
}

model AssessmentTemplate {
  id          String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String                      @unique
  name        String
  description String?
  created_at  DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime                    @default(now()) @updatedAt @db.Timestamptz(6)
  versions    AssessmentTemplateVersion[]

  @@map("assessment_templates")
}

/// One `published` version per template (partial unique index uq_template_versions_one_published).
model AssessmentTemplateVersion {
  id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_id  String                  @db.Uuid
  label        String
  status       AssessmentVersionStatus @default(draft)
  published_at DateTime?               @db.Timestamptz(6)
  published_by String?                 @db.Uuid
  created_by   String?                 @db.Uuid
  created_at   DateTime                @default(now()) @db.Timestamptz(6)
  updated_at   DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  template     AssessmentTemplate      @relation(fields: [template_id], references: [id], onDelete: NoAction)
  publisher    User?                   @relation("VersionPublishedBy", fields: [published_by], references: [id], onDelete: SetNull)
  creator      User?                   @relation("VersionCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  sections     AssessmentSection[]
  assessments  Assessment[]

  @@unique([template_id, label], map: "uq_template_versions_label")
  @@map("assessment_template_versions")
}

model AssessmentSection {
  id           String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version_id   String                     @db.Uuid
  code         String
  title_en     String
  title_fil    String
  sort_order   Int                        @default(0)
  /// Set: the whole section needs that area (VII, IX, XI–XVII).
  area_type_id String?                    @db.Uuid
  created_at   DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at   DateTime                   @default(now()) @updatedAt @db.Timestamptz(6)
  version      AssessmentTemplateVersion  @relation(fields: [version_id], references: [id], onDelete: Cascade)
  area_type    BuildingAreaType?          @relation(fields: [area_type_id], references: [id], onDelete: NoAction)
  items        AssessmentItem[]
  comments     AssessmentSectionComment[]

  @@unique([version_id, code], map: "uq_assessment_sections_code")
  @@index([version_id, sort_order], map: "idx_assessment_sections_version_order")
  @@map("assessment_sections")
}

/// A group parent (I.3, III.2, IV.1 …) has is_scored = false and holds the shared prompt; its
/// sub-items are scored. Unique (section, parent, code) through the expression index
/// uq_assessment_items_code; CHECK chk_assessment_items_pillar: scored items have a pillar,
/// group parents don't.
model AssessmentItem {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  section_id   String                @db.Uuid
  parent_id    String?               @db.Uuid
  code         String
  prompt_en    String
  prompt_fil   String
  note_en      String?
  note_fil     String?
  reference    String?
  is_scored    Boolean               @default(true)
  safe_answer  AssessmentSafeAnswer  @default(yes)
  area_type_id String?               @db.Uuid
  min_floors   Int?
  flag_label   String?
  pillar_id    String?               @db.Uuid
  sort_order   Int                   @default(0)
  created_at   DateTime              @default(now()) @db.Timestamptz(6)
  updated_at   DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  section      AssessmentSection     @relation(fields: [section_id], references: [id], onDelete: Cascade)
  parent       AssessmentItem?       @relation("ItemChildren", fields: [parent_id], references: [id], onDelete: Cascade)
  children     AssessmentItem[]      @relation("ItemChildren")
  area_type    BuildingAreaType?     @relation(fields: [area_type_id], references: [id], onDelete: NoAction)
  pillar       DrrmPillar?           @relation(fields: [pillar_id], references: [id], onDelete: NoAction)
  answers      AssessmentAnswerRow[]

  @@index([section_id, sort_order], map: "idx_assessment_items_section_order")
  @@map("assessment_items")
}

/// A building under its main unit (campus and cluster come through the unit). Unique
/// (unit_id, lower(name)) through the expression index uq_buildings_unit_name. floor_count and
/// `areas` are the current profile, used to pre-fill the next assessment.
model Building {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unit_id     String         @db.Uuid
  name        String
  floor_count Int            @default(1)
  is_active   Boolean        @default(true)
  created_by  String?        @db.Uuid
  created_at  DateTime       @default(now()) @db.Timestamptz(6)
  updated_at  DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  unit        Unit           @relation(fields: [unit_id], references: [id], onDelete: NoAction)
  creator     User?          @relation("BuildingCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  areas       BuildingArea[]
  assessments Assessment[]

  @@index([unit_id])
  @@map("buildings")
}

model BuildingArea {
  building_id  String           @db.Uuid
  area_type_id String           @db.Uuid
  building     Building         @relation(fields: [building_id], references: [id], onDelete: Cascade)
  area_type    BuildingAreaType @relation(fields: [area_type_id], references: [id], onDelete: NoAction)

  @@id([building_id, area_type_id])
  @@map("building_areas")
}

/// One building assessed with one template version. Immutable after submit. client_ref is the
/// draft's id on the phone, so an offline replay that already landed isn't inserted twice.
model Assessment {
  id                  String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_ref          String                     @unique @db.Uuid
  template_version_id String                     @db.Uuid
  building_id         String                     @db.Uuid
  event_id            String?                    @db.Uuid
  evaluator_id        String                     @db.Uuid
  incident_commander  String                     @default("")
  floor_count         Int
  started_at          DateTime                   @db.Timestamptz(6)
  ended_at            DateTime                   @db.Timestamptz(6)
  needs_follow_up     Boolean                    @default(false)
  created_at          DateTime                   @default(now()) @db.Timestamptz(6)
  version             AssessmentTemplateVersion  @relation(fields: [template_version_id], references: [id], onDelete: NoAction)
  building            Building                   @relation(fields: [building_id], references: [id], onDelete: NoAction)
  event               Event?                     @relation(fields: [event_id], references: [id], onDelete: SetNull)
  evaluator           User                       @relation("AssessmentEvaluator", fields: [evaluator_id], references: [id], onDelete: NoAction)
  areas               AssessmentArea[]
  answers             AssessmentAnswerRow[]
  pillar_scores       AssessmentPillarScore[]
  comments            AssessmentSectionComment[]

  @@index([building_id, ended_at(sort: Desc)], map: "idx_assessments_building_ended")
  @@index([ended_at(sort: Desc)], map: "idx_assessments_ended")
  @@index([evaluator_id, ended_at(sort: Desc)], map: "idx_assessments_evaluator")
  @@map("assessments")
}

model AssessmentArea {
  assessment_id String           @db.Uuid
  area_type_id  String           @db.Uuid
  assessment    Assessment       @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  area_type     BuildingAreaType @relation(fields: [area_type_id], references: [id], onDelete: NoAction)

  @@id([assessment_id, area_type_id])
  @@map("assessment_areas")
}

/// CHECK chk_assessment_answers_content: an answer or remarks. Group parents carry remarks only.
model AssessmentAnswerRow {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessment_id String            @db.Uuid
  item_id       String            @db.Uuid
  answer        AssessmentAnswer?
  remarks       String?
  created_at    DateTime          @default(now()) @db.Timestamptz(6)
  assessment    Assessment        @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  item          AssessmentItem    @relation(fields: [item_id], references: [id], onDelete: NoAction)

  @@unique([assessment_id, item_id], map: "uq_assessment_answers_item")
  @@map("assessment_answers")
}

/// Written once at submit, four rows per assessment. CHECK chk_assessment_pillar_scores_counts.
model AssessmentPillarScore {
  assessment_id String     @db.Uuid
  pillar_id     String     @db.Uuid
  safe_count    Int        @default(0)
  counted_count Int        @default(0)
  na_count      Int        @default(0)
  assessment    Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  pillar        DrrmPillar @relation(fields: [pillar_id], references: [id], onDelete: NoAction)

  @@id([assessment_id, pillar_id])
  @@map("assessment_pillar_scores")
}

model AssessmentSectionComment {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessment_id String            @db.Uuid
  section_id    String            @db.Uuid
  comment       String
  created_at    DateTime          @default(now()) @db.Timestamptz(6)
  assessment    Assessment        @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  section       AssessmentSection @relation(fields: [section_id], references: [id], onDelete: NoAction)

  @@unique([assessment_id, section_id], map: "uq_assessment_section_comments_section")
  @@map("assessment_section_comments")
}
