{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "permissions": {
    "allow": ["Bash(node:*)"],
    "deny": [
      "Bash(npx prisma db push*)",
      "Bash(npx prisma db migrate*)",
      "Bash(npx prisma migrate*)",
      "Bash(*prisma db push*)",
      "Bash(*prisma*migrate*deploy*)"
    ]
  }
}
